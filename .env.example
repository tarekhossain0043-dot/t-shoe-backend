DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=https://t-shoe-bd.vercel.app/
FRONTEND_URL=https://t-shoe-bd.vercel.app/
BACKEND_PUBLIC_URL=https://t-shoe-bd.vercel.app/api/

# Get sandbox credentials from your bKash merchant/developer onboarding.
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v2/tokenized-checkout
BKASH_APP_KEY=your-sandbox-app-key
BKASH_APP_SECRET=your-sandbox-app-secret
BKASH_USERNAME=your-sandbox-username
BKASH_PASSWORD=your-sandbox-password

# Nagad sandbox API base URL provided for this integration.
NAGAD_API_BASE_URL=https://sandboxapi.nagad.com.bd/remote-payment-gateway-1.0
NAGAD_MERCHANT_ID=your-sandbox-merchant-id
NAGAD_MERCHANT_NUMBER=your-sandbox-merchant-number
NAGAD_MERCHANT_PRIVATE_KEY_PATH=C:\path\to\nagad-merchant-private-key.pem
NAGAD_PG_PUBLIC_KEY_PATH=C:\path\to\nagad-gateway-public-key.pem
NAGAD_CLIENT_IP=127.0.0.1
