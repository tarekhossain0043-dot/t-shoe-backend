DJANGO_DEBUG=true
DJANGO_SECRET_KEY=generate-a-private-random-value
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://t-shoe-bd.vercel.app
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
# Leave blank for local SQLite. Set the managed PostgreSQL connection URL in deployment.
DATABASE_URL=

# Set credentials issued for your bKash merchant account. Never commit actual credentials.
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v2/tokenized-checkout
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Set credentials and certificate paths issued for your Nagad merchant account.
NAGAD_API_BASE_URL=https://sandboxapi.nagad.com.bd/remote-payment-gateway-1.0
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_MERCHANT_PRIVATE_KEY_PATH=
NAGAD_PG_PUBLIC_KEY_PATH=
NAGAD_CLIENT_IP=127.0.0.1
