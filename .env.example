# Render production environment template.
# Set DJANGO_SECRET_KEY to a NEW, private random value in Render; never commit the real value.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-new-private-random-secret
DJANGO_ALLOWED_HOSTS=t-shoe-backend.onrender.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://t-shoes.vercel.app,https://t-shoe-bd.vercel.app,http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=https://t-shoes.vercel.app
BACKEND_PUBLIC_URL=https://t-shoe-backend.onrender.com

# Set this to the actual Internal Database URL from your Render PostgreSQL database.
# Do NOT use a URL ending in /api/products/ here.
DATABASE_URL=

# Payment credentials are optional for COD. Add real provider credentials only when configured.
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v2/tokenized-checkout
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_API_BASE_URL=https://sandboxapi.nagad.com.bd/remote-payment-gateway-1.0
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_MERCHANT_PRIVATE_KEY_PATH=
NAGAD_PG_PUBLIC_KEY_PATH=
NAGAD_CLIENT_IP=127.0.0.1
